<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="UniversityDBiap"
         connectionString="Server=.;Database=UniversityDBiap;Trusted_Connection=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" requestValidationMode="2.0" />
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" />
    <globalization culture="en-US" uiCulture="en-US" requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />
    <customErrors mode="RemoteOnly" />
    <authentication mode="None" />
    <httpModules>
      <add name="GateModule" type="UniversityStudentSearch.GateModule, UniversityStudentSearch" />
    </httpModules>
    <httpHandlers>
      <add path="gate/access" verb="*" type="UniversityStudentSearch.GateHandler, UniversityStudentSearch" />
      <add path="gate/commands" verb="*" type="UniversityStudentSearch.GateHandler, UniversityStudentSearch" />
      <add path="gate/ack" verb="*" type="UniversityStudentSearch.GateHandler, UniversityStudentSearch" />
    </httpHandlers>
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules>
      <add name="GateModule" type="UniversityStudentSearch.GateModule, UniversityStudentSearch" />
    </modules>
    <handlers>
      <add name="GateAccess" path="gate/access" verb="*" type="UniversityStudentSearch.GateHandler, UniversityStudentSearch" resourceType="Unspecified" />
      <add name="GateCommands" path="gate/commands" verb="*" type="UniversityStudentSearch.GateHandler, UniversityStudentSearch" resourceType="Unspecified" />
      <add name="GateAck" path="gate/ack" verb="*" type="UniversityStudentSearch.GateHandler, UniversityStudentSearch" resourceType="Unspecified" />
    </handlers>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
