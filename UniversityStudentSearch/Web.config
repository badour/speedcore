<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="UniversityDBiap"
         connectionString="Server=.;Database=UniversityDBiap;Trusted_Connection=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" requestValidationMode="2.0" />
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" />
    <globalization culture="en-US" uiCulture="en-US" requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />
    <customErrors mode="RemoteOnly" />
    <authentication mode="None" />
    <httpModules>
      <add name="IclockModule" type="UniversityStudentSearch.IclockModule, UniversityStudentSearch" />
    </httpModules>
    <httpHandlers>
      <add path="iclock/cdata" verb="*" type="UniversityStudentSearch.IclockHandler, UniversityStudentSearch" />
      <add path="iclock/getrequest" verb="*" type="UniversityStudentSearch.IclockHandler, UniversityStudentSearch" />
      <add path="iclock/devicecmd" verb="*" type="UniversityStudentSearch.IclockHandler, UniversityStudentSearch" />
      <add path="iclock/ping" verb="*" type="UniversityStudentSearch.IclockHandler, UniversityStudentSearch" />
      <add path="iclock/registry" verb="*" type="UniversityStudentSearch.IclockHandler, UniversityStudentSearch" />
    </httpHandlers>
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules>
      <add name="IclockModule" type="UniversityStudentSearch.IclockModule, UniversityStudentSearch" />
    </modules>
    <handlers>
      <add name="IclockCdata" path="iclock/cdata" verb="*" type="UniversityStudentSearch.IclockHandler, UniversityStudentSearch" resourceType="Unspecified" />
      <add name="IclockGetRequest" path="iclock/getrequest" verb="*" type="UniversityStudentSearch.IclockHandler, UniversityStudentSearch" resourceType="Unspecified" />
      <add name="IclockDeviceCmd" path="iclock/devicecmd" verb="*" type="UniversityStudentSearch.IclockHandler, UniversityStudentSearch" resourceType="Unspecified" />
      <add name="IclockPing" path="iclock/ping" verb="*" type="UniversityStudentSearch.IclockHandler, UniversityStudentSearch" resourceType="Unspecified" />
      <add name="IclockRegistry" path="iclock/registry" verb="*" type="UniversityStudentSearch.IclockHandler, UniversityStudentSearch" resourceType="Unspecified" />
    </handlers>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
